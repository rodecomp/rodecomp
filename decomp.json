{
  "name": "rodecomp",
  "sourceDirs": [
    "Source",
    "ThirdParty"
  ],
  "includeDirs": [],
  "headerGlobs": [
    "Source/**/*.h",
    "Source/**/*.hpp",
    "Source/**/*.inl"
  ],
  "toolchain": "ragnarok",
  "globalRules": true,
  "matchPolicy": {
    "reviewAt": "match_unresolved",
    "maxCleanupCycles": 5,
    "approvals": 1,
    "approvalsWithHeaderChanges": 2
  },
  "lintLimits": {
    "maxInitializerNumbers": 65536
  },
  "compileCommands": "compile.json"
}
