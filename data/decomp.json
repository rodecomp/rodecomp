{
 "name": "rodecomp",
 "sourceDirs": [
  "Source",
  "ThirdParty"
 ],
 "includeDirs": [],
 "headerGlobs": [
  "Source/**/*.h",
  "Source/**/*.hpp",
  "Source/**/*.inl"
 ],
 "toolchain": "ragnarok",
 "globalRules": true,
 "offsetAnnotations": true,
 "encodedLiterals": [
  {
   "macro": "CRYPT_NAME",
   "kind": "xor-repeating-key",
   "keyBytes": 8,
   "includeTerminator": true
  },
  {
   "macro": "CRYPT_CHARS",
   "kind": "xor-repeating-key",
   "keyBytes": 8,
   "includeTerminator": true,
   "lengthArgument": true
  },
  {
   "macro": "CRYPT_BYTES",
   "kind": "xor-repeating-key",
   "keyBytes": 8,
   "includeTerminator": true,
   "lengthArgument": true
  },
  {
   "macro": "OBFUSCATE_STRING",
   "kind": "xor-repeating-key",
   "keyBytes": 8,
   "includeTerminator": true
  },
  {
   "macro": "OBFUSCATE_STRING_BODY",
   "kind": "xor-repeating-key",
   "keyBytes": 8,
   "includeTerminator": true
  },
  {
   "macro": "OBFUSCATE_ARRAY",
   "kind": "xor-repeating-key",
   "keyBytes": 8,
   "includeTerminator": true
  },
  {
   "macro": "OBFUSCATE_ARRAY_BODY",
   "kind": "xor-repeating-key",
   "keyBytes": 8,
   "includeTerminator": true
  },
  {
   "macro": "OBFUSCATE_TEXT",
   "kind": "xor-repeating-key",
   "keyBytes": 8,
   "includeTerminator": true
  },
  {
   "macro": "OBFUSCATE_TEXT_NAMED",
   "kind": "xor-repeating-key",
   "keyBytes": 8,
   "includeTerminator": true
  },
  {
   "macro": "OBFUSCATE_SOURCE_TEXT",
   "kind": "xor-repeating-key",
   "keyBytes": 8,
   "includeTerminator": true
  },
  {
   "macro": "OBFUSCATE_SOURCE_TEXT_NAMED",
   "kind": "xor-repeating-key",
   "keyBytes": 8,
   "includeTerminator": true
  },
  {
   "macro": "OBFUSCATE_BYTES_TEXT",
   "kind": "xor-repeating-key",
   "keyBytes": 8,
   "includeTerminator": true
  }
 ],
 "matchPolicy": {
  "reviewAt": "match_unresolved",
  "maxCleanupCycles": 5,
  "approvals": 1,
  "approvalsWithHeaderChanges": 2
 },
 "exeBuild": [
  "python",
  "scripts/exe/build_exe.py"
 ],
 "lintLimits": {
  "maxInitializerNumbers": 65536,
  "maxFiles": 2048
 },
 "compileCommands": "data/compile.json",
 "unitPrelude": "Source/Linkage"
}
