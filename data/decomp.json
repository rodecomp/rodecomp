{
 "name": "rodecomp",
 "sourceDirs": [
  "Source",
  "ThirdParty"
 ],
 "includeDirs": [],
 "headerGlobs": [
  "Source/**/*.h",
  "Source/**/*.hpp",
  "Source/**/*.inl"
 ],
 "toolchain": "ragnarok",
 "globalRules": true,
 "offsetAnnotations": true,
 "allowedPragmas": [
  "once",
  "pack",
  "warning",
  "intrinsic",
  "function",
  "inline_depth",
  "inline_recursion",
  "optimize",
  "push_macro",
  "pop_macro",
  "auto_inline",
  "check_stack",
  "pointers_to_members",
  "vtordisp",
  "init_seg",
  "message"
 ],
